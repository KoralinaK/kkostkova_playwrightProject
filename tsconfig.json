{
  "compilerOptions": {
    "target": "es2020",
    "module": "es2020",
    "strict": true,
    "baseUrl": ".",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true, //musi byt aby bylo možné využivat ddt - importovat json
    "moduleResolution": "node",
    "types": ["@playwright/test", "@types/node"],
    "resolveJsonModule": true //musí byt aby šlo importovat json
  },
  "include": ["src", "tests"],
  "exclude": ["node_modules", "dist"]
}
